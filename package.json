{
  "name": "cypress-demowebshop-framework",
  "version": "1.0.0",
  "description": "Full Cypress POM Automation Framework for Tricentis Demo Web Shop",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "cy:run:auth": "cypress run --spec 'cypress/e2e/auth/**/*.cy.js'",
    "cy:run:cart": "cypress run --spec 'cypress/e2e/cart/**/*.cy.js'",
    "cy:run:checkout": "cypress run --spec 'cypress/e2e/checkout/**/*.cy.js'",
    "cy:run:product": "cypress run --spec 'cypress/e2e/product/**/*.cy.js'",
    "cy:run:search": "cypress run --spec 'cypress/e2e/search/**/*.cy.js'",
    "cy:run:wishlist": "cypress run --spec 'cypress/e2e/wishlist/**/*.cy.js'",
    "cy:run:account": "cypress run --spec 'cypress/e2e/account/**/*.cy.js'",
    "cy:run:smoke": "cypress run --env tags=smoke",
    "cy:run:regression": "cypress run --env tags=regression",
    "cy:report": "npx mochawesome-merge cypress/reports/json/*.json -o cypress/reports/merged.json && npx marge cypress/reports/merged.json -f report -o cypress/reports/html",
    "cy:clean": "rm -rf cypress/reports cypress/screenshots cypress/videos allure-results allure-report",

    "allure:clean": "rm -rf allure-results allure-report",
    "allure:generate": "npx allure generate allure-results -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:allure": "npm run allure:clean && cypress run && npm run allure:report",

    "allure:run": "node scripts/allure-history.js",
    "allure:run:auth": "node scripts/allure-history.js --spec 'cypress/e2e/auth/**/*.cy.js'",
    "allure:run:smoke": "node scripts/allure-history.js --env tags=smoke",
    "allure:run:regression": "node scripts/allure-history.js --env tags=regression",
    "allure:run:login": "node scripts/allure-history.js --spec 'cypress/e2e/auth/login.cy.js'",
    "allure:run:register": "node scripts/allure-history.js --spec 'cypress/e2e/auth/register.cy.js'",

    "allure:history:list": "ls -la allure-history/ 2>/dev/null || echo 'No history yet — run npm run allure:run first'",
    "allure:history:clean": "rm -rf allure-history && echo 'History cleared.'"
  },
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "cypress": "^13.6.0"
  },
  "devDependencies": {
    "@bahmutov/cy-api": "^2.2.10",
    "allure": "^3.3.1",
    "allure-cypress": "^3.6.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "cypress-multi-reporters": "^1.6.4",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
